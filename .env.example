# .env.example — copia este archivo como .env y rellena los valores reales.
# NUNCA añadas credenciales reales a este archivo ni lo subas a Git con datos sensibles.

# -----------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------

# DB_TYPE: mariadb (producción) | sqlite (desarrollo sin MariaDB)
DB_TYPE=mariadb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=milo
DB_USER=milo_app
DB_PASSWORD=CAMBIAR_PASSWORD

# Opcionales (los valores por defecto son razonables):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10

# -----------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------

AGENDA_HOST=0.0.0.0
AGENDA_PORT=8000
# AGENDA_BACKUP_DIR=data/backups

# -----------------------------------------------------------------------
# Solo si DB_TYPE=sqlite (desarrollo local)
# -----------------------------------------------------------------------

# AGENDA_DB=data/agenda.db

# -----------------------------------------------------------------------
# Datos de ejemplo al arrancar (1 = sí, vacío = no)
# -----------------------------------------------------------------------

# AGENDA_SEED=1
